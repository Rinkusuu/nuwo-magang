# Nuwo Magang, Apache. Document root harus folder public/. Untuk Nginx lihat deploy/nginx.conf.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # SAMEORIGIN: pratinjau PDF ditampilkan di iframe halaman sendiri
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=()"
  # tanpa CSP untuk PDF, penampil PDF bawaan peramban terblokir CSP
  <If "%{REQUEST_URI} !~ m#^/api/(pkl/)?file\.php#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  </If>
  # Aktifkan setelah HTTPS berjalan stabil:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  <FilesMatch "\.(woff2|png|jpe?g|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# laporan akhir maksimal 10 MB
<IfModule mod_php.c>
  php_value upload_max_filesize 11M
  php_value post_max_size 12M
  php_flag display_errors off
  php_flag expose_php off
</IfModule>
